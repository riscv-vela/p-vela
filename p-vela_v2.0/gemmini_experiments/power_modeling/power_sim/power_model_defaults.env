# Shared by single/dual shell runners and Python collectors/scalers.
# Use literal KEY=value assignments only; no shell expansion or commands.
# Explicit runner/CLI options override defaults. Changes apply to new processes.

# Gemmini binary activity model (W, percent).
DEFAULT_GEMMINI_FULL_UTIL_POWER_W=0.862
DEFAULT_GEMMINI_IDLE_POWER_W=0.014
DEFAULT_GEMMINI_UTIL_THRESHOLD_PCT=80

# CPU power model: sys_scale * (a * utilization * frequency_GHz^3 + k).
DEFAULT_SYS_SCALE=0.5625
DEFAULT_FIXED_FREQ_GHZ=2.512
CPU_BOOST_OFF_THRESHOLD_GHZ=2.6
CPU_A_BOOST=0.039747769
CPU_K_BOOST=2.80057
CPU_A_NOM=0.086391591
CPU_K_NOM=0.184415

# Measurement intervals (seconds).
DEFAULT_TURBOSTAT_INTERVAL_S=0.1
DEFAULT_POWER_POLL_INTERVAL_S=0.1
DEFAULT_VCPU_SAMPLE_INTERVAL_S=0.1

# Time model. Single/dual runners use rtl-cycle; CPU keeps a fixed time factor.
DEFAULT_TIME_SCALE_MODE=rtl-cycle
DEFAULT_GEMMINI_FREQUENCY_MHZ=200
DEFAULT_CPU_TIME_SCALE=0.3035
DEFAULT_CPU_REF_TARGET_RATIO=0.3333333333333333

# Scaled plot presentation (seconds, inches).
DEFAULT_SCALED_PLOT_WINDOW_MARGIN_S=0.5
DEFAULT_SCALED_PLOT_FIG_WIDTH=10.5
DEFAULT_PLOT_TIME_MAJOR_TICK_S=0.1
